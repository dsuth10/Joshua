{"nodes": [{"id": "$graphify-root$_agent_skills_leveled_text_creator_skill_md", "label": "SKILL.md", "file_type": "document", "node_kind": "page", "source_file": ".agent/skills/leveled-text-creator/SKILL.md", "source_location": "L1", "frontmatter": {"name": "leveled-text-creator", "description": "Generates educational reading passages calibrated for specific Australian Curriculum Year levels (Prep/Year 1 to Year 10). It employs the textstat Python library to analyse readability (Flesch-Kincaid Grade Level and Flesch Reading Ease) and runs an iterative drafting process to refine complexity. Simplification prioritises shortening sentences and adopting simple grammatical structures while retaining key subject-specific technical terminology and explaining abstract terms inline. Outputs Markdown, a detai"}}, {"id": "$graphify-root$_agent_skills_leveled_text_creator_skill_leveled_text_creator_skill", "label": "Leveled Text Creator Skill", "file_type": "document", "node_kind": "heading", "source_file": ".agent/skills/leveled-text-creator/SKILL.md", "source_location": "L9"}, {"id": "$graphify-root$_agent_skills_leveled_text_creator_skill_readability_year_level_mapping", "label": "Readability & Year-Level Mapping", "file_type": "document", "node_kind": "heading", "source_file": ".agent/skills/leveled-text-creator/SKILL.md", "source_location": "L15"}, {"id": "$graphify-root$_agent_skills_leveled_text_creator_skill_technical_content_simplification_rules", "label": "Technical Content & Simplification Rules", "file_type": "document", "node_kind": "heading", "source_file": ".agent/skills/leveled-text-creator/SKILL.md", "source_location": "L34"}, {"id": "$graphify-root$_agent_skills_leveled_text_creator_skill_outputs", "label": "Outputs", "file_type": "document", "node_kind": "heading", "source_file": ".agent/skills/leveled-text-creator/SKILL.md", "source_location": "L48"}, {"id": "$graphify-root$_agent_skills_leveled_text_creator_skill_workflow_agent_guided_execution", "label": "