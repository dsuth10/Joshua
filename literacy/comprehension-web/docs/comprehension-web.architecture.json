  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime shape",
      "items": [
        "No app server — static HTML/CSS/JS only",
        "Drafts never leave the device until export",
        "Response files are schemaVersion 1.0 JSON"
      ]
    },
    {
      "dot": "emerald",
      "title": "Primary path",
      "items": [
        "Hub → handout → localStorage draft → JSON download",
        "Teacher drops files into Results/",
        "grade_results.py writes scored-results/"
      ]
    },
    {
      "dot": "amber",
      "title": "Authoring note",
      "items": [
        "Markdown under content/ seeds handout HTML",
        "Shared chrome: shared/site.css + site.js"
