      "title": "Source File Sha256",
      "type": "string"
    },
    "source_path": {
      "title": "Source Path",
      "type": "string"
    },
    "start_line": {
      "title": "Start Line",
      "type": "integer"
    },
    "word_count": {
      "title": "Word Count",
      "type": "integer"
    }
