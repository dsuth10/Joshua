        },
        {
          "$ref": "#/$defs/PageRangeSelector"
        },
        {
          "$ref": "#/$defs/ParagraphRangeSelector"
        },
        {
          "$ref": "#/$defs/LineRangeSelector"
        },
        {
          "$ref": "#/$defs/LiteralStartEndSelector"
        }
