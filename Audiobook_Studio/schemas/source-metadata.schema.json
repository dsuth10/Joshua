          "minLength": 1,
          "title": "Start Heading",
          "type": "string"
        },
        "type": {
          "const": "heading_range",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "start_heading",
        "end_before_heading"
      ],
      "title": "HeadingRangeSelector",
      "type": "object"
    },
    "HeadingSelector": {
      "additionalProperties": false,
      "properties": {
        "heading": {
