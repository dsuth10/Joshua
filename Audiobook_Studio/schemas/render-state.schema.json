{
  "$defs": {
    "ChunkRenderRecord": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "audio_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Sha256"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "mastered_audio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mastered Audio"
        },
        "mastering_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Mastering Revision",
          "type": "integer"
        },
        "raw_audio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Audio"
        },
        "render_key": {
          "title": "Render Key",
          "type": "string"
        },
        "seeds": {
          "items": {
            "type": "integer"
          },
          "title": "Seeds",
          "type": "array"
        },
        "status": {
          "enum": [
            "generated",
            "qa_pass",
            "qa_fail",
            "manual_review"
          ],
          "title": "Status",
          "type": "string"
        },
        "worker_lock_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worker Lock Sha256"
        }
      },
      "required": [
        "chunk_id",
        "render_key",
        "status",
        "attempts",
        "seeds"
      ],
      "title": "ChunkRenderRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cache_hits": {
      "default": 0,
      "title": "Cache Hits",
      "type": "integer"
    },
    "chunks": {
      "additionalProperties": {
        "$ref": "#/$defs/ChunkRenderRecord"
      },
      "title": "Chunks",
      "type": "object"
    },
    "failed": {
      "default": 0,
      "title": "Failed",
      "type": "integer"
    },
    "generated": {
      "default": 0,
      "title": "Generated",
      "type": "integer"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "updated_at",
    "chunks"
  ],
  "title": "RenderState",
  "type": "object"
}
