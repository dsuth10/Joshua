{
  "$defs": {
    "NarrationChunk": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "emotion_strength": {
          "maximum": 1,
          "minimum": 0,
          "title": "Emotion Strength",
          "type": "number"
        },
        "emphasis_spans": {
          "items": {
            "type": "string"
          },
          "title": "Emphasis Spans",
          "type": "array"
        },
        "pause_after_ms": {
          "maximum": 2000,
          "minimum": 0,
          "title": "Pause After Ms",
          "type": "integer"
        },
        "pause_before_ms": {
          "maximum": 2000,
          "minimum": 0,
          "title": "Pause Before Ms",
          "type": "integer"
        },
        "pronunciation_keys": {
          "items": {
            "type": "string"
          },
          "title": "Pronunciation Keys",
          "type": "array"
        },
        "replacements": {
          "items": {
            "$ref": "#/$defs/PronunciationReplacement"
          },
          "title": "Replacements",
          "type": "array"
        },
        "source_paragraph_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Paragraph Ids",
          "type": "array"
        },
        "source_text": {
          "title": "Source Text",
          "type": "string"
        },
        "source_text_sha256": {
          "title": "Source Text Sha256",
          "type": "string"
        },
        "spoken_text": {
          "title": "Spoken Text",
          "type": "string"
        },
        "spoken_text_sha256": {
          "title": "Spoken Text Sha256",
          "type": "string"
        },
        "style": {
          "enum": [
            "reflective",
            "remembered_speech",
            "tense",
            "neutral"
          ],
          "title": "Style",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "source_paragraph_ids",
        "source_text",
        "spoken_text",
        "style",
        "emotion_strength",
        "pause_before_ms",
        "pause_after_ms",
        "source_text_sha256",
        "spoken_text_sha256"
      ],
      "title": "NarrationChunk",
      "type": "object"
    },
    "PronunciationReplacement": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "replacement": {
          "title": "Replacement",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "source",
        "replacement",
        "start",
        "end"
      ],
      "title": "PronunciationReplacement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chunks": {
      "items": {
        "$ref": "#/$defs/NarrationChunk"
      },
      "minItems": 1,
      "title": "Chunks",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "lexicon_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Lexicon Sha256"
    },
    "planner": {
      "enum": [
        "ollama",
        "deterministic_fallback"
      ],
      "title": "Planner",
      "type": "string"
    },
    "planner_model": {
      "title": "Planner Model",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_text_sha256": {
      "title": "Source Text Sha256",
      "type": "string"
    },
    "voice_profile_sha256": {
      "title": "Voice Profile Sha256",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "source_text_sha256",
    "voice_profile_sha256",
    "lexicon_sha256",
    "planner",
    "planner_model",
    "created_at",
    "chunks"
  ],
  "title": "NarrationPlan",
  "type": "object"
}
