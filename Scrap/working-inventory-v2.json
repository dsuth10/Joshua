          "font_size": 50.32,
          "color": "000000",
          "line_spacing": 50.32
        },
        {
          "text": "Here is the sky,",
          "alignment": "CENTER",
          "font_name": "Canva Student Font",
          "font_size": 50.32,
          "color": "000000",
          "line_spacing": 50.32
        },
        {
          "text": "Here are my friends, and here am I.",
          "alignment": "CENTER",
          "font_name": "Canva Student Font",
          "font_size": 50.32,
          "color": "000000",
          "line_spacing": 50.32
        },
        {
          "text": "We thank the Jagera, Yuggera and Ugarapul people for the land on which we learn and play.",
          "alignment": "CENTER",
          "font_name": "Canva Student Font",
          "font_size": 50.32,
          "color": "000000",
          "line_spacing": 50.32
        },
        {
          "text": "Hands up, hands down, we’re on Jagera, Yuggera and Ugarapul ground.",
          "alignment": "CENTER",
          "font_name": "Canva Student Font",
          "font_size": 50.32,
          "color": "000000",
          "line_spacing": 50.32
        }
      ]
