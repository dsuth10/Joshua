      "height": 4.24,
      "paragraphs": [
        {
          "text": "We acknowledge the Traditional Custodians of the lands, seas, skies and waterways from across Queensland. Here we acknowledge the Jagera, Yuggera and Ugarapul people. We pay our respect to the Elders, past, present and emerging, for they hold the memories, traditions, the culture and hopes of Aboriginal and Torres Strait Islander peoples across Queensland and Australia.",
          "alignment": "CENTER",
          "font_name": "Canva Student Font",
          "font_size": 50.36,
          "color": "000000",
          "line_spacing": 50.36
        }
      ]
